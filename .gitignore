# Корневой .gitignore монорепозитория. У сервисов в apps/ есть свои
# .gitignore — здесь только общее и то, что лежит вне сервисов.

# ─── Секреты ─────────────────────────────────────────────────────────────────
# Реальные значения окружения: пароли инфраструктуры, JWT_SECRET, ключи S3.
# В репозиторий попадает только .env.example.
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
build/
dist/
*.egg-info/
.venv/
venv/
.uv/
.python-version.local

# Кеши инструментов
.ruff_cache/
.mypy_cache/
.pytest_cache/
.cache/

# Покрытие тестами
.coverage
.coverage.*
coverage.xml
htmlcov/

# ─── Node (фронтенд и боты на JS, если появятся) ─────────────────────────────
node_modules/
.next/
.nuxt/
.svelte-kit/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Docker и инфраструктура ─────────────────────────────────────────────────
# Локальные переопределения compose: у каждого разработчика свои порты и маунты.
docker-compose.override.yml
# Данные сервисов, если volume смонтирован каталогом, а не именованным томом.
infra/data/
# Локальные Docker secrets; примеры хранятся вне этого каталога.
infra/secrets/
# Состояние terraform, если инфраструктура дорастёт до него: содержит секреты
# в открытом виде.
*.tfstate
*.tfstate.*
.terraform/

# ─── Логи и временные файлы ──────────────────────────────────────────────────
*.log
logs/
tmp/
*.bak
*.orig
*.rej

# ─── Редакторы и ОС ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
