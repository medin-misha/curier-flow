{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@0.0.79",
        "--isolated",
        "--headless",
        "--browser",
        "chromium"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm run dev*": "allow",
      "npm run test*": "allow",
      "npm test*": "allow",
      "npm run typecheck*": "allow",
      "npm run build*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git reset*": "deny",
      "git clean*": "deny",
      "git checkout*": "deny"
    }
  }
}
