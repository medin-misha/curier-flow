# Скопируйте файл в .env и заполните значения: cp .env.example .env
#
# Переменные делятся на две группы:
#   * настройки приложения — читаются только через pydantic-settings
#     (app.kernel.config и Settings-классы модулей), напрямую os.environ
#     в коде запрещён линтером;
#   * настройки docker compose — логины, пароли и порты инфраструктуры,
#     которые читает сам compose.
# Порты вынесены в переменные, чтобы шаблон не конфликтовал с другими
# проектами, поднятыми на той же машине.

# ─── Приложение ──────────────────────────────────────────────────────────────
# Окружение: local | dev | staging | prod. Влияет на формат логов и /health/info.
APP_ENV=local
APP_NAME=backend-template
# Версия сборки; в CI подставляется тег или короткий SHA коммита.
APP_VERSION=0.1.0
# DEBUG=true открывает /docs, /redoc и /openapi.json. В prod всегда false.
# Наружу трейсбеки не отдаются никогда: подробности ошибки уходят только в лог.
DEBUG=true
# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
# json — для сбора логов в проде, console — читаемый вывод при локальной разработке.
LOG_FORMAT=console
# Базовый URI типов ошибок в ответах problem+json (RFC 9457): type = {база}/{код}.
# Указывайте на страницу с описанием кодов ошибок, если она у сервиса есть.
ERRORS_BASE_URL=https://errors.local

# Адрес, на котором слушает uvicorn (цель `make run`).
API_HOST=127.0.0.1
API_PORT=8000

# Сколько секунд воркер ждёт завершения уже начатой работы после SIGTERM.
# Должно быть меньше таймаута остановки контейнера (по умолчанию 30 секунд
# и у docker, и у kubernetes), иначе процесс добьют SIGKILL посреди обработки.
WORKER_SHUTDOWN_TIMEOUT=30
# Сколько задач TaskIQ воркер выполняет одновременно. Ориентир — размер пула
# соединений к БД: задачи ходят в базу, и без предела упрутся именно в него.
WORKER_MAX_CONCURRENT_TASKS=10

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
# DSN приложения: драйвер обязательно asyncpg, синхронный psycopg не используется.
DATABASE_DSN=postgresql+asyncpg://app:app@localhost:5432/app
# Размер пула соединений на один процесс (uvicorn worker или worker).
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=5
# true — логировать все SQL-запросы. Только для отладки, в проде очень шумно.
DATABASE_ECHO=false

# Параметры контейнера postgres в docker compose.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
# Транспорт сообщений во внешние сервисы и брокер задач TaskIQ.
RABBITMQ_DSN=amqp://guest:guest@localhost:5672/
# Сколько раз упавшее сообщение вернётся в очередь через очередь выдержки
# (retry_ttl_ms в TopologyDecl), прежде чем уйти в DLQ. 0 — повторов нет.
RABBITMQ_MAX_RETRIES=5
# Параметры контейнера rabbitmq в docker compose.
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
# Веб-интерфейс управления: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672

# ─── Доменные события (outbox) ───────────────────────────────────────────────
# Событие пишется в таблицу outbox в транзакции сервиса, а публикует его релей
# воркера. Имена обмена и очереди доменных событий — константы кода
# (domain.events / domain.events.subscribers), а не настройки: релей и
# консьюмер обязаны сойтись на одном имени.
# Как часто просыпается релей, в секундах. Это же — задержка доставки события
# в худшем случае. Целое число не меньше 1: дробный интервал шедулер не примет.
OUTBOX_RELAY_INTERVAL=5
# Сколько строк релей публикует за один проход. Пачка едет в одной транзакции,
# поэтому большое значение — это долгое удержание блокировок на строках.
OUTBOX_BATCH_SIZE=100
# После скольких неудачных публикаций сообщение уезжает в очередь несъедобных
# (domain.events.subscribers.dlq), а строка помечается опубликованной с
# заполненным last_error. При значениях по умолчанию это примерно час попыток.
OUTBOX_MAX_ATTEMPTS=12
# Отсрочка повтора: строка снова видна релею, когда её возраст перерос
# OUTBOX_RETRY_BASE_DELAY * 2^(attempts-1) секунд, но не больше потолка.
# Первая попытка отсрочки не получает.
OUTBOX_RETRY_BASE_DELAY=5
OUTBOX_RETRY_MAX_DELAY=3600
# Сколько дней хранятся успешно опубликованные строки, прежде чем их удалит
# ночная уборка. Строки, уехавшие в DLQ, не удаляются никогда — это материал
# для разбора инцидента.
OUTBOX_RETENTION_DAYS=7
# Расписание уборки в формате cron (UTC).
OUTBOX_CLEANUP_CRON=17 3 * * *

# ─── Redis ───────────────────────────────────────────────────────────────────
# Result backend TaskIQ: сюда складываются результаты выполнения задач.
REDIS_DSN=redis://localhost:6379/0
# Сколько секунд хранится результат задачи. Без ограничения Redis копил бы их
# вечно: результат нужен только тому, кто поставил задачу, и только пока ждёт.
REDIS_RESULT_TTL=86400
REDIS_PORT=6379

# ─── S3 / MinIO ──────────────────────────────────────────────────────────────
# Файлы не проходят через backend: клиент льёт их напрямую по presigned URL,
# поэтому endpoint должен быть доступен клиенту, а не только контейнерам.
# Адрес, по которому в хранилище ходит само приложение.
S3_ENDPOINT_URL=http://localhost:9000
# Адрес, по которому в хранилище приходит клиент. Пусто — тот же, что выше.
# Заполнять нужно, когда приложение и клиент видят хранилище по-разному:
# в docker compose приложение ходит на http://minio:9000, а браузер — на
# http://localhost:9000. Подпись SigV4 накрывает заголовок Host, поэтому
# ссылка, подписанная на внутренний адрес, снаружи отдаст SignatureDoesNotMatch,
# и подменить в ней хост нельзя — только подписать по правильному адресу.
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=app-files
# Время жизни presigned-ссылок в секундах.
S3_PRESIGN_TTL=900

# Параметры контейнера minio в docker compose.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
# Веб-консоль MinIO: http://localhost:9001
MINIO_CONSOLE_PORT=9001

# ─── Модуль health ───────────────────────────────────────────────────────────
# Таймауты проверок /health/ready, в секундах. У каждой зависимости свой: один
# зависший бэкенд не должен задерживать весь ответ, а разумное терпение к базе
# в соседней подсети и к объектному хранилищу за интернетом отличается.
# Проверки идут параллельно, поэтому ответ занимает не больше самого крупного
# из этих значений; оно обязано быть меньше интервала опроса оркестратора.
HEALTH_DATABASE_TIMEOUT=2
HEALTH_BROKER_TIMEOUT=2
HEALTH_STORAGE_TIMEOUT=2

# ─── Модуль storage ──────────────────────────────────────────────────────────
# Предел размера одного файла в байтах (25 МиБ). Проверяется дважды: по заявке
# клиента — до выдачи ссылки, по факту — при подтверждении загрузки.
STORAGE_MAX_FILE_SIZE=26214400
# Разрешённые типы содержимого через запятую. Белый список: перечислить нужное
# короче и безопаснее, чем угадывать все опасные типы. Тип вшивается в подпись
# ссылки, поэтому загрузить исполняемый файл под видом картинки не выйдет.
STORAGE_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp,application/pdf
# Сколько секунд ждать загрузку, прежде чем считать запись брошенной и убрать
# её вместе с объектом. Заметно больше S3_PRESIGN_TTL: пока ссылка жива,
# клиент вправе долить файл.
STORAGE_ORPHAN_TTL=3600
# Расписание сборщика брошенных загрузок в формате cron (UTC).
STORAGE_ORPHAN_SWEEP_CRON=*/15 * * * *
# Как часто удалять помеченные файлы, в секундах. Это же — задержка между
# ответом на DELETE и исчезновением объекта из бакета.
STORAGE_DELETION_INTERVAL=60
# Сколько файлов задача обрабатывает за один проход: каждый файл — отдельный
# запрос к хранилищу, и слишком большая пачка растягивает проход.
STORAGE_BATCH_SIZE=100

# ─── Durable staging aggregate uploads ──────────────────────────────────────
# Через сколько секунд незавершённая aggregate-загрузка становится доступной
# универсальной компенсации. Строка staging создаётся до первого S3-вызова.
FILE_UPLOAD_STAGING_TTL=86400
# Расписание универсальной cleanup-задачи staging в формате cron (UTC).
FILE_UPLOAD_STAGING_CLEANUP_CRON=*/15 * * * *
# Максимум staging rows, которые один проход claim'ит через SKIP LOCKED.
FILE_UPLOAD_STAGING_BATCH_SIZE=100
# Срок cleanup lease в секундах. После него прерванный deleting claim можно
# безопасно взять снова; активный lease второй worker не обрабатывает.
FILE_UPLOAD_STAGING_CLAIM_TTL=300

# ─── Модуль courier_module ──────────────────────────────────────────────────
# Максимум документов в одном aggregate POST. Завышенное значение увеличивает
# временный диск multipart parser и длительность последовательной S3-загрузки.
COURIER_MODULE_MAX_DOCUMENTS=20
# Суммарный фактический лимит bytes одного multipart-запроса (100 МиБ).
# Reverse proxy/ASGI должен ограничивать request body тем же значением.
COURIER_MODULE_MAX_TOTAL_UPLOAD_SIZE=104857600
# Product defaults хранения по purpose, в днях. Это не юридическая
# рекомендация: compliance обязан переопределить сроки для своего окружения.
COURIER_MODULE_RETENTION_PLATFORM_ONBOARDING_DAYS=90
COURIER_MODULE_RETENTION_EMPLOYMENT_COMPLIANCE_DAYS=1825
COURIER_MODULE_RETENTION_OTHER_DAYS=365
# Ночной retention sweep в UTC. Слишком частый запуск создаёт лишнюю нагрузку.
COURIER_MODULE_RETENTION_CRON=29 2 * * *
# Максимум документов в одном SKIP LOCKED batch retention-задачи.
COURIER_MODULE_RETENTION_BATCH_SIZE=100

# ─── Идемпотентность записи ──────────────────────────────────────────────────
# Ручки, помеченные @idempotent, требуют заголовок Idempotency-Key: ключ, ответ
# и данные запроса коммитятся одной транзакцией, повтор с тем же ключом и тем
# же телом получает сохранённый ответ, с другим телом — 409.
# Сколько часов ключ защищает от повтора. Это верхняя граница разумного ретрая:
# повтор через сутки — это уже намерение клиента, а не сбой сети.
IDEMPOTENCY_RETENTION_HOURS=24
# Расписание уборки просроченных ключей в формате cron (UTC).
IDEMPOTENCY_CLEANUP_CRON=23 4 * * *

# Отметки об обработанных сообщениях (таблица processed_messages) защищают от
# повторной доставки at-least-once. Растут со скоростью всего потока сообщений,
# поэтому убираются так же, как ключи идемпотентности.
# Сколько дней хранится отметка: горизонт, в котором брокер и релей ещё могут
# прислать сообщение повторно.
PROCESSED_MESSAGES_RETENTION_DAYS=7
# Расписание уборки отметок в формате cron (UTC).
PROCESSED_MESSAGES_CLEANUP_CRON=41 3 * * *

# ─── Безопасность ────────────────────────────────────────────────────────────
# Секрет подписи JWT. В проде — значение из секрет-хранилища, не из репозитория:
# при APP_ENV=prod процесс с этим значением по умолчанию не поднимется вовсе.
# Годится любая случайная строка, например `openssl rand -hex 32`.
JWT_SECRET=change-me-in-production
# HS256 годится, пока токены выпускает и проверяет один сервис. Как только их
# начнёт проверять чужой, нужен асимметричный алгоритм: иначе секрет придётся
# раздать всем проверяющим, а вместе с ним и право выпускать токены.
JWT_ALGORITHM=HS256
# Время жизни токенов в секундах: access — минуты, refresh — дни. Отозвать
# выданный access нельзя, поэтому его TTL — это окно, в течение которого
# утёкший токен ещё работает.
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600
