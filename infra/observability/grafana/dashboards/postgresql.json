{
  "annotations": {"list": []},
  "description": "PostgreSQL: контейнерные ресурсы, postgres-exporter и логи.",
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "index": 0, "text": "Нет свежих метрик"}, "1": {"color": "green", "index": 1, "text": "Работает"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "value_and_name"},
      "targets": [{"editorMode": "code", "expr": "(time() - max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"})) < bool 90 or on() vector(0)", "instant": true, "legendFormat": "PostgreSQL", "range": false, "refId": "A"}],
      "title": "Состояние контейнера",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "dateTimeFromNow"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "value_and_name"},
      "targets": [{"editorMode": "code", "expr": "max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"}) * 1000", "instant": true, "legendFormat": "Последняя метрика", "range": false, "refId": "A"}],
      "title": "Последняя метрика",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"decimals": 0}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "value_and_name"},
      "targets": [{"editorMode": "code", "expr": "changes(max(container_start_time_seconds{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"})[$__range:1m])", "instant": true, "legendFormat": "Изменения запуска", "range": false, "refId": "A"}],
      "title": "Перезапуски / новые запуски",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Метрика postgres-exporter. No data означает отсутствие exporter target.",
      "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"color": "red", "index": 0, "text": "Недоступна"}, "1": {"color": "green", "index": 1, "text": "Доступна"}}, "type": "value"}]}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "value_and_name"},
      "targets": [{"editorMode": "code", "expr": "max(pg_up)", "instant": true, "legendFormat": "postgres-exporter", "range": false, "refId": "A"}],
      "title": "PostgreSQL доступна",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "id": 5,
      "targets": [{"editorMode": "code", "expr": "sum(rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"}[5m])) * 100", "legendFormat": "PostgreSQL", "range": true, "refId": "A"}],
      "title": "CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "id": 6,
      "targets": [{"editorMode": "code", "expr": "sum(container_memory_working_set_bytes{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"})", "legendFormat": "PostgreSQL", "range": true, "refId": "A"}],
      "title": "Рабочая память",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "id": 7,
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(container_network_receive_bytes_total{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"}[5m]))", "legendFormat": "Получено", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(rate(container_network_transmit_bytes_total{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"}[5m]))", "legendFormat": "Отправлено", "range": true, "refId": "B"}
      ],
      "title": "Сеть",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "short"}, "overrides": [{"matcher": {"id": "byName", "options": "Размер БД"}, "properties": [{"id": "unit", "value": "bytes"}]}]},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "id": 8,
      "targets": [
        {"editorMode": "code", "expr": "sum(pg_stat_activity_count)", "legendFormat": "Соединения", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(pg_database_size_bytes)", "legendFormat": "Размер БД", "range": true, "refId": "B"}
      ],
      "title": "PostgreSQL exporter",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"min": 0, "unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
      "id": 10,
      "targets": [
        {"editorMode": "code", "expr": "sum(rate(container_fs_reads_bytes_total{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"}[5m]))", "legendFormat": "Чтение", "range": true, "refId": "A"},
        {"editorMode": "code", "expr": "sum(rate(container_fs_writes_bytes_total{container_label_com_docker_compose_project=\"curier-flow-infra\",container_label_com_docker_compose_service=\"postgres\"}[5m]))", "legendFormat": "Запись", "range": true, "refId": "B"}
      ],
      "title": "Дисковый I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "loki", "uid": "loki"},
      "fieldConfig": {"defaults": {}, "overrides": []},
      "gridPos": {"h": 11, "w": 24, "x": 0, "y": 28},
      "id": 9,
      "options": {"dedupStrategy": "none", "enableLogDetails": true, "showCommonLabels": false, "showLabels": false, "showTime": true, "sortOrder": "Descending", "wrapLogMessage": true},
      "targets": [{"editorMode": "code", "expr": "{compose_project=\"curier-flow-infra\",compose_service=\"postgres\"}", "queryType": "range", "refId": "A"}],
      "title": "Логи PostgreSQL",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["curier-flow", "infra", "service"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Сервис: PostgreSQL",
  "uid": "cf-service-postgresql",
  "version": 1
}
