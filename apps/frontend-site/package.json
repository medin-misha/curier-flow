    "test:e2e": "playwright test"
  },
  "dependencies": {"vue": "^3.5.41"},
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.3.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
