{
  "name": "mfs-frontend-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3000",
    "typecheck": "vue-tsc --noEmit",
