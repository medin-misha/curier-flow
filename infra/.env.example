# Единый .env docker-стека: его читают оба compose-файла этого каталога —
# и для подстановки ${...}, и как env_file процессов api и worker.
#
#   cp infra/.env.example infra/.env
#   make -C infra up
#
# Здесь только то, что нужно compose'у и отличается от дефолтов кода. Полный
# список настроек бекенда с объяснением каждой — apps/backend/.env.example;
# любую из них можно дописать сюда, и она уедет в контейнеры как есть.
# Значения ниже совпадают с дефолтами внутри compose-файлов и внутри кода:
# расхождение сломает подключение приложения к инфраструктуре.

# ─── Приложение ──────────────────────────────────────────────────────────────
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
# В контейнере логи читает не человек, а сборщик; console оставлять только
# на время отладки руками.
LOG_FORMAT=json
# Порт, на котором api торчит наружу с хоста.
API_PORT=8000
# Публичный сайт: http://localhost:3000
FRONTEND_SITE_PORT=3000
# Админ-панель: http://localhost:5173
FRONTEND_ADMIN_PORT=5173
# Обязательно поменять вне local: этим ключом подписываются токены доступа.
JWT_SECRET=change-me-in-production

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
# DSN приложения внутри compose подставляется из переменных выше и переопределяет
# эту строку. Хостовые инструменты могут использовать её при явной передаче env.
DATABASE_DSN=postgresql+asyncpg://app:app@localhost:5432/app

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
# Веб-консоль: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DSN=amqp://guest:guest@localhost:5672/

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_DSN=redis://localhost:6379/0

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
# Веб-консоль: http://localhost:9001
MINIO_CONSOLE_PORT=9001
# Бакет заводит контейнер minio-init до старта приложения: /health/ready делает
# по нему HEAD и без бакета красный с первого запуска.
S3_BUCKET=app-files
S3_ENDPOINT_URL=http://localhost:9000
# Ключи приложения внутри compose берутся из MINIO_ROOT_*; эта пара нужна
# запуску с хоста и должна совпадать с ними.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
