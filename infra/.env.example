# Единый .env docker-стека: его читают compose-файлы этого каталога —
# и для подстановки ${...}, и как env_file процессов api и worker. Telegram bot
# получает из этого файла только явно перечисленные настройки без секретов
# backend.
#
#   cp infra/.env.example infra/.env
#   make -C infra up
#
# Здесь только то, что нужно compose'у и отличается от дефолтов кода. Полный
# список настроек бекенда с объяснением каждой — apps/backend/.env.example;
# любую из них можно дописать сюда, и она уедет в контейнеры как есть.
# Значения ниже совпадают с дефолтами внутри compose-файлов и внутри кода:
# расхождение сломает подключение приложения к инфраструктуре.

# ─── Приложение ──────────────────────────────────────────────────────────────
APP_ENV=local
DEBUG=true
LOG_LEVEL=INFO
# В контейнере логи читает не человек, а сборщик; console оставлять только
# на время отладки руками.
LOG_FORMAT=json
# Порт, на котором api торчит наружу с хоста.
API_PORT=8000
# Публичный сайт: http://localhost:3000
FRONTEND_SITE_PORT=3000
# Админ-панель: http://localhost:5173
FRONTEND_ADMIN_PORT=5173
# Обязательно поменять вне local: этим ключом подписываются токены доступа.
JWT_SECRET=change-me-in-production
# Первый Admin создаётся в lifespan API только при пустой таблице admins. Перед
# первым `make -C infra up` замени пример пароля; после создания Admin bootstrap-
# credentials можно убрать из infra/.env, чтобы plaintext-секрет не жил дольше
# необходимого. Username: 3–64 символа из a-z, 0-9, точки, подчёркивания и дефиса.
ADMIN_BOOTSTRAP_USERNAME=admin
# Пароль должен содержать 12–128 символов. Это заметный пример, не реальный
# секрет: обязательно замени его своим значением до первого старта.
ADMIN_BOOTSTRAP_PASSWORD=change-me-before-first-start
# Необязательный положительный Telegram user ID первого Admin. Оставь пустым,
# если Telegram-уведомления этому администратору пока не нужны.
ADMIN_BOOTSTRAP_TELEGRAM_ID=

# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5432
# DSN приложения внутри compose подставляется из переменных выше и переопределяет
# эту строку. Хостовые инструменты могут использовать её при явной передаче env.
DATABASE_DSN=postgresql+asyncpg://app:app@localhost:5432/app

# ─── RabbitMQ ────────────────────────────────────────────────────────────────
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
# Веб-консоль: http://localhost:15672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_DSN=amqp://guest:guest@localhost:5672/

# ─── Telegram notifications ──────────────────────────────────────────────────
# Необязательный для остального стека token от BotFather. При пустом значении
# make выводит предупреждение, но не создаёт и не запускает Telegram worker.
# Чтобы включить worker, задай token здесь или через shell-окружение: shell
# имеет стандартный Compose-приоритет над infra/.env. Рабочее значение не
# коммитить и не передавать через build args.
TELEGRAM_BOT_TOKEN=
# Максимальное число повторов после временных ошибок Telegram API.
TELEGRAM_MAX_RETRIES=5
# Таймаут одного HTTP-запроса к Telegram API, секунды.
TELEGRAM_API_TIMEOUT=10
# Время на завершение in-flight сообщения после SIGTERM, секунды. Compose даёт
# процессу 40 секунд до SIGKILL, оставляя запас поверх этого значения.
TELEGRAM_SHUTDOWN_TIMEOUT=30

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_DSN=redis://localhost:6379/0

# ─── MinIO ───────────────────────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
# Веб-консоль: http://localhost:9001
MINIO_CONSOLE_PORT=9001
# Бакет заводит контейнер minio-init до старта приложения: /health/ready делает
# по нему HEAD и без бакета красный с первого запуска.
S3_BUCKET=app-files
S3_ENDPOINT_URL=http://localhost:9000
# Ключи приложения внутри compose берутся из MINIO_ROOT_*; эта пара нужна
# запуску с хоста и должна совпадать с ними.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# ─── Observability ────────────────────────────────────────────────────────────
# Единственный опубликованный порт logging-проекта: http://<server>:3001.
# Он слушает все host-интерфейсы без TLS по явно принятому operational решению;
# ограничение доступа firewall остаётся ответственностью окружения сервера.
GRAFANA_PORT=3001
# 720 часов и 30 дней соответственно. Оба значения можно увеличить до запуска,
# если Docker volume рассчитан на дополнительный объём данных.
LOKI_RETENTION_PERIOD=720h
PROMETHEUS_RETENTION_TIME=30d
# Пароль Grafana не хранится в общем infra/.env. Перед первым `make -C infra up`
# создай отдельный игнорируемый файл (одна строка, без имени переменной):
#
#   mkdir -p infra/secrets
#   openssl rand -base64 32 > infra/secrets/grafana_admin_password
#   chmod 600 infra/secrets/grafana_admin_password
#
# Формат показан в infra/observability/grafana_admin_password.example.
