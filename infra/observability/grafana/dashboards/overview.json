    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "1 означает, что cAdvisor видел контейнер в последние 90 секунд. Telegram worker может отсутствовать штатно.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": {"color": "red", "index": 0, "text": "Нет свежих метрик"},
                "1": {"color": "green", "index": 1, "text": "Работает"}
              },
              "type": "value"
            }
          ],
          "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": false}, "textMode": "value_and_name"},
      "targets": [
        {"editorMode": "code", "expr": "(time() - max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-apps\",container_label_com_docker_compose_service=\"api\"})) < bool 90 or on() vector(0)", "instant": true, "legendFormat": "API", "range": false, "refId": "A"},
        {"editorMode": "code", "expr": "(time() - max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-apps\",container_label_com_docker_compose_service=\"worker\"})) < bool 90 or on() vector(0)", "instant": true, "legendFormat": "Backend worker", "range": false, "refId": "B"},
        {"editorMode": "code", "expr": "(time() - max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-apps\",container_label_com_docker_compose_service=\"telegram-bot\"})) < bool 90 or on() vector(0)", "instant": true, "legendFormat": "Telegram worker (optional)", "range": false, "refId": "C"},
        {"editorMode": "code", "expr": "(time() - max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-apps\",container_label_com_docker_compose_service=\"frontend-site\"})) < bool 90 or on() vector(0)", "instant": true, "legendFormat": "Frontend site", "range": false, "refId": "D"},
        {"editorMode": "code", "expr": "(time() - max(container_last_seen{container_label_com_docker_compose_project=\"curier-flow-apps\",container_label_com_docker_compose_service=\"frontend-admin\"})) < bool 90 or on() vector(0)", "instant": true, "legendFormat": "Frontend admin", "range": false, "refId": "E"}
